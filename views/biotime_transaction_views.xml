<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biotime_transaction_view_list" model="ir.ui.view">
        <field name="name">biotime.transaction.list</field>
        <field name="model">biotime.transaction</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'error'" decoration-muted="state == 'skipped'"
                  decoration-success="state == 'processed'">
                <header>
                    <button name="action_process" string="Transfer to Attendance" type="object"/>
                    <button name="action_retry" string="Retry" type="object"/>
                    <button name="action_skip" string="Skip" type="object"/>
                </header>
                <field name="punch_time"/>
                <field name="emp_code"/>
                <field name="emp_name" optional="show"/>
                <field name="employee_id"/>
                <field name="punch_state_display"/>
                <field name="verify_type" optional="show"/>
                <field name="terminal_alias" optional="show"/>
                <field name="server_id" optional="hide"/>
                <field name="state"/>
                <field name="error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="biotime_transaction_view_form" model="ir.ui.view">
        <field name="name">biotime.transaction.form</field>
        <field name="model">biotime.transaction</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_process" string="Transfer to Attendance" type="object"
                            class="btn-primary" invisible="state in ('processed', 'skipped')"/>
                    <button name="action_retry" string="Retry" type="object" invisible="state not in ('error', 'skipped')"/>
                    <button name="action_skip" string="Skip" type="object" invisible="state in ('processed', 'skipped')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="server_id"/>
                            <field name="biotime_id"/>
                            <field name="punch_time"/>
                            <field name="emp_code"/>
                            <field name="emp_name"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="punch_state"/>
                            <field name="punch_state_display"/>
                            <field name="verify_type"/>
                            <field name="device_id"/>
                            <field name="device_sn"/>
                            <field name="terminal_alias"/>
                            <field name="area_alias"/>
                            <field name="attendance_id"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biotime_transaction_view_search" model="ir.ui.view">
        <field name="name">biotime.transaction.search</field>
        <field name="model">biotime.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="emp_code"/>
                <field name="emp_name"/>
                <field name="employee_id"/>
                <field name="terminal_alias"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="error" string="Errors" domain="[('state', '=', 'error')]"/>
                <filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('punch_time', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_device" string="Device" context="{'group_by': 'terminal_alias'}"/>
                    <filter name="g_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'punch_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="biotime_transaction_view_graph" model="ir.ui.view">
        <field name="name">biotime.transaction.graph</field>
        <field name="model">biotime.transaction</field>
        <field name="arch" type="xml">
            <graph string="Punches" type="bar">
                <field name="punch_time" interval="day"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="biotime_transaction_action" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">biotime.transaction</field>
        <field name="view_mode">list,graph,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
