<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated views so the standard Odoo attendance reports stay untouched -->
    <record id="biotime_attendance_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.biotime.list</field>
        <field name="model">hr.attendance</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list decoration-danger="bt_status == 'missing_checkout'" decoration-warning="bt_status == 'late'">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="bt_net_hours" widget="float_time"/>
                <field name="bt_overtime_hours" widget="float_time"/>
                <field name="bt_status"/>
                <field name="bt_late_minutes"/>
                <field name="bt_early_out_minutes"/>
                <field name="bt_server_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="biotime_attendance_view_graph" model="ir.ui.view">
        <field name="name">hr.attendance.biotime.graph</field>
        <field name="model">hr.attendance</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Late minutes per day" type="bar">
                <field name="check_in" interval="day"/>
                <field name="bt_status"/>
                <field name="bt_late_minutes" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="biotime_attendance_view_pivot" model="ir.ui.view">
        <field name="name">hr.attendance.biotime.pivot</field>
        <field name="model">hr.attendance</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Attendance KPIs">
                <field name="employee_id" type="row"/>
                <field name="check_in" interval="month" type="col"/>
                <field name="bt_late_minutes" type="measure"/>
                <field name="bt_overtime_hours" type="measure"/>
                <field name="bt_net_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="biotime_attendance_view_search" model="ir.ui.view">
        <field name="name">hr.attendance.biotime.search</field>
        <field name="model">hr.attendance</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <filter name="from_biotime" string="From BioTime" domain="[('bt_server_id', '!=', False)]"/>
                <filter name="late" string="Late In" domain="[('bt_status', '=', 'late')]"/>
                <filter name="missing" string="Missing Check-out" domain="[('bt_status', '=', 'missing_checkout')]"/>
                <filter name="overtime" string="Overtime" domain="[('bt_overtime_hours', '>', 0)]"/>
                <group>
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_status" string="Status" context="{'group_by': 'bt_status'}"/>
                    <filter name="g_day" string="Day" context="{'group_by': 'check_in:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="biotime_attendance_action" model="ir.actions.act_window">
        <field name="name">BioTime Attendance</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="search_view_id" ref="biotime_attendance_view_search"/>
        <field name="context">{'search_default_from_biotime': 1}</field>
    </record>
    <record id="biotime_attendance_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="biotime_attendance_view_list"/>
        <field name="act_window_id" ref="biotime_attendance_action"/>
    </record>
    <record id="biotime_attendance_action_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="biotime_attendance_view_graph"/>
        <field name="act_window_id" ref="biotime_attendance_action"/>
    </record>
    <record id="biotime_attendance_action_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="biotime_attendance_view_pivot"/>
        <field name="act_window_id" ref="biotime_attendance_action"/>
    </record>

    <!-- Dashboard: dedicated OWL screen (static/src/dashboard) -->
    <record id="biotime_dashboard_client_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">biotime_dashboard</field>
    </record>
</odoo>
