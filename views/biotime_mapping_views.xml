<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biotime_mapping_view_list" model="ir.ui.view">
        <field name="name">biotime.mapping.review.list</field>
        <field name="model">biotime.mapping.review</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="status in ('conflict', 'suggested')"
                  decoration-muted="status == 'ignored'"
                  decoration-success="status == 'mapped'">
                <header>
                    <button name="action_apply" string="Apply Mapping" type="object"
                            class="btn-primary" help="Link the selected employee"/>
                    <button name="action_create_employee" string="Create New Employee" type="object"
                            help="Create an Odoo employee for this BioTime code"/>
                    <button name="action_ignore" string="Ignore" type="object"/>
                    <button name="action_reload" string="Refresh from BioTime" type="object"/>
                </header>
                <field name="emp_code"/>
                <field name="bt_name"/>
                <field name="department_name" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'mapped'"
                       decoration-warning="status in ('conflict', 'suggested')"
                       decoration-muted="status == 'ignored'"/>
                <field name="employee_id" domain="[('company_id', 'in', (False, company_id))]"/>
                <field name="punches" sum="Total" optional="show"/>
                <field name="candidate_names" optional="hide"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="biotime_mapping_view_search" model="ir.ui.view">
        <field name="name">biotime.mapping.review.search</field>
        <field name="model">biotime.mapping.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="emp_code"/>
                <field name="bt_name"/>
                <field name="employee_id"/>
                <filter name="needs_mapping" string="Needs Mapping"
                        domain="[('status', 'in', ('unmapped', 'conflict', 'suggested'))]"/>
                <filter name="mapped" string="Mapped" domain="[('status', '=', 'mapped')]"/>
                <filter name="conflict" string="Conflicts" domain="[('status', '=', 'conflict')]"/>
                <group>
                    <filter name="g_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="g_dept" string="Department" context="{'group_by': 'department_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="biotime_mapping_action" model="ir.actions.act_window">
        <field name="name">Employee Mapping</field>
        <field name="res_model">biotime.mapping.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_mapping': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent">Load the employee list from a BioTime server first.</p>
            <p>Open the server record and click "Review Employee Mapping".</p>
        </field>
    </record>

    <menuitem id="menu_biotime_mapping" name="Employee Mapping" parent="menu_biotime_review"
              action="biotime_mapping_action" sequence="1"/>
</odoo>
