<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Three levels: User (read), Supervisor (process/retry punches), Manager (configure servers) -->
    <record id="group_biotime_user" model="res.groups">
        <field name="name">BioTime: User</field>
    </record>
    <record id="group_biotime_supervisor" model="res.groups">
        <field name="name">BioTime: Supervisor</field>
        <field name="implied_ids" eval="[(4, ref('group_biotime_user'))]"/>
    </record>
    <record id="group_biotime_manager" model="res.groups">
        <field name="name">BioTime: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_biotime_supervisor'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_biotime_manager'))]"/>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_biotime_server_company" model="ir.rule">
        <field name="name">BioTime server: multi-company</field>
        <field name="model_id" ref="model_biotime_server"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_biotime_device_company" model="ir.rule">
        <field name="name">BioTime device: multi-company</field>
        <field name="model_id" ref="model_biotime_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_biotime_transaction_company" model="ir.rule">
        <field name="name">BioTime punch: multi-company</field>
        <field name="model_id" ref="model_biotime_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_biotime_log_company" model="ir.rule">
        <field name="name">BioTime log: multi-company</field>
        <field name="model_id" ref="model_biotime_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_biotime_job_company" model="ir.rule">
        <field name="name">BioTime job: multi-company</field>
        <field name="model_id" ref="model_biotime_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Late reasons: employees see their own + their department's; officers see all -->
    <record id="rule_late_reason_scope" model="ir.rule">
        <field name="name">BioTime late reason: own or department</field>
        <field name="model_id" ref="model_biotime_late_reason"/>
        <field name="groups" eval="[(4, ref('group_biotime_user'))]"/>
        <field name="domain_force">['|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id', '=', False),
            ('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_late_reason_officer" model="ir.rule">
        <field name="name">BioTime late reason: HR officers</field>
        <field name="model_id" ref="model_biotime_late_reason"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Overtime sheets: same scoping -->
    <record id="rule_overtime_scope" model="ir.rule">
        <field name="name">BioTime overtime: own or department</field>
        <field name="model_id" ref="model_biotime_overtime_sheet"/>
        <field name="groups" eval="[(4, ref('group_biotime_user'))]"/>
        <field name="domain_force">['|', '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_id', '=', False),
            ('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_overtime_officer" model="ir.rule">
        <field name="name">BioTime overtime: HR officers</field>
        <field name="model_id" ref="model_biotime_overtime_sheet"/>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
