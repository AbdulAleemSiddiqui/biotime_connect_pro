<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biotime_pull_wizard_view_form" model="ir.ui.view">
        <field name="name">biotime.pull.wizard.form</field>
        <field name="model">biotime.pull.wizard</field>
        <field name="arch" type="xml">
            <form string="Pull Transactions">
                <group>
                    <group>
                        <field name="server_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="device_id" options="{'no_create': True}"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="transfer"/>
                        <field name="background"/>
                    </group>
                </group>
                <footer>
                    <button name="action_pull" string="Pull" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="biotime_pull_wizard_action" model="ir.actions.act_window">
        <field name="name">Pull Transactions</field>
        <field name="res_model">biotime.pull.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
